{
  "name": "eli-desktop",
  "version": "0.4.4",
  "description": "Eli — a heart-shaped AI companion that lives on your desktop",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.eli.companion",
    "productName": "Eli",
    "artifactName": "Eli-Setup-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "E:/Eli-Dist",
      "buildResources": "build-resources"
    },
    "files": [
      "main.js",
      "preload.js",
      "guide-preload.js",
      "onboarding-preload.js",
      "renderer/**/*",
      "guide/**/*",
      "onboarding/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "build-resources/backend", "to": "backend", "filter": ["**/*"] },
      { "from": "build-resources/python", "to": "python", "filter": ["**/*"] }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/heart-256.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Eli"
    }
  }
}
