# Copy to backend/.env and fill in what you need. Everything is optional.

# LLM Provider Keys (At least one recommended; otherwise Ellie runs in offline rule-based mode)
# Google Gemini (Recommended: fast, cost-effective, multi-modal)
GEMINI_API_KEY=

# Anthropic Claude (Alternative)
ANTHROPIC_API_KEY=

# OpenAI (Alternative)
OPENAI_API_KEY=

# Model selection.
# For Gemini: gemini-2.0-flash, gemini-1.5-flash
# For Claude: claude-3-5-sonnet-20241022, claude-opus-5
ELI_MODEL=gemini-2.0-flash
ELI_EFFORT=medium

# Server
ELI_HOST=0.0.0.0
ELI_PORT=8790

# Vision
ELI_CAPTURE_INTERVAL=5

# Speech
ELI_WHISPER_MODEL=base.en     # tiny.en (fastest) | base.en | small.en (most accurate)
ELI_TTS_RATE=185
ELI_TTS_VOICE=                # e.g. Zira, David — substring of an installed Windows voice

# Memory embeddings: hash (no download) | fastembed (pip install fastembed; semantic)
ELI_EMBEDDER=hash
