# LLM Provider selection: auto | ollama | groq | openrouter | gemini | anthropic | offline
ELI_LLM_PROVIDER=auto

# Option 1: 100% Free & Offline On-Device LLM (Ollama - https://ollama.com)
# Install Ollama, run `ollama run llama3.2` or `qwen2.5:3b`. Zero API keys needed!
OLLAMA_HOST=http://127.0.0.1:11434
ELI_OLLAMA_MODEL=llama3.2

# Option 2: 100% Free Cloud LLM (Groq - https://console.groq.com)
# Super-fast 300+ tok/sec Llama 3.3 70B with generous free tier (no credit card required)
GROQ_API_KEY=
ELI_GROQ_MODEL=llama-3.3-70b-versatile

# Option 3: Google Gemini (Free tier at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
ELI_GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Option 4: Anthropic Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
ELI_MODEL=claude-opus-5
ELI_EFFORT=medium

# Server
ELI_HOST=0.0.0.0
ELI_PORT=8790

# Vision
ELI_CAPTURE_INTERVAL=5

# Speech
ELI_WHISPER_MODEL=base.en     # tiny.en (fastest) | base.en | small.en (most accurate)
ELI_TTS_RATE=185
ELI_TTS_VOICE=                # e.g. Zira, David — substring of an installed Windows voice

# Memory embeddings: hash (no download) | fastembed (pip install fastembed; semantic)
ELI_EMBEDDER=hash
