# Copy to backend/.env and fill in what you need. Everything is optional.

# Reasoning + vision (Anthropic). Without a key Eli runs in offline mode:
# rule-based commands, Windows OCR, error explanations, memory, voice all still work.
ANTHROPIC_API_KEY=

# Model and effort. claude-opus-5 is the default; claude-sonnet-5 is cheaper/faster.
ELI_MODEL=claude-opus-5
ELI_EFFORT=medium

# Server
ELI_HOST=0.0.0.0
ELI_PORT=8790

# Vision
ELI_CAPTURE_INTERVAL=5

# Speech
ELI_WHISPER_MODEL=base.en     # tiny.en (fastest) | base.en | small.en (most accurate)
ELI_TTS_RATE=185
ELI_TTS_VOICE=                # e.g. Zira, David — substring of an installed Windows voice

# Memory embeddings: hash (no download) | fastembed (pip install fastembed; semantic)
ELI_EMBEDDER=hash
